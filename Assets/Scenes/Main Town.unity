--- !u!114 &90482613
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 90482608}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d2d0c38ebc53929459a18731dffc5e08, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPC
  npcName: Police Officer
  dialogueLines: []
  choices: []
  specificDialogue:
  - monsterGroupName: Vampire
    specialDialogue:
    - 'Stop! I need to know where you were last night, we got reports of somone knocking
      on doors and asking to be let in. '
    specialChoices:
    - choiceText: I just arrived in town today.
      responseLines:
      - Well stay out of trouble if thats the case.
    - choiceText: Does this happen often?
      responseLines:
      - All too often, the people who live here are a little too soft for my liking.
  - monsterGroupName: Werewolf
    specialDialogue:
    - 'Hey you wouldn''t have happened to lost a dog recently? '
    specialChoices:
    - choiceText: A dog?
      responseLines:
      - Yeah, we've been getting reports of loud howls at night.
    - choiceText: No, sorry.
      responseLines:
      - Well stay safe, this town gets weird during full moons.
