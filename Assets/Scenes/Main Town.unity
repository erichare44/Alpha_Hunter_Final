  m_GameObject: {fileID: 396548400}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d2d0c38ebc53929459a18731dffc5e08, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPC
  npcName: Sweet Lady
  dialogueLines:
  - Better get inside sweetie, I heard there's a monster out again.
  choices:
  - choiceText: Are monsters common here?
    responseLines:
    - Oh you know how rumor's spread...
    - When I was youger, our parents told us stories to keep us from misbehaving.
  - choiceText: Where can I find it?
    responseLines:
    - I'm not too sure, but they say you can hear them if you stray too far from
      town.
  specificDialogue: []
